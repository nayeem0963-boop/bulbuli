{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bulbuli.org/schemas/grammar-course.json",
  "title": "Bulbuli grammar course",
  "description": "One grammar course, split into 3–4 sections of topic cards. Each card has a short rule badge, a recap and 3 multiple-choice questions. Learner-facing labels come in English and Bangla; the English example sentences stay English.",
  "type": "object",
  "required": [
    "version",
    "id",
    "title",
    "tagline",
    "subtitle",
    "sections",
    "cards"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/slug",
      "description": "Also the file name."
    },
    "title": {
      "$ref": "#/$defs/bilingual"
    },
    "tagline": {
      "$ref": "#/$defs/bilingual",
      "description": "The big heading, like “Master the 12 tenses”."
    },
    "subtitle": {
      "$ref": "#/$defs/bilingual",
      "description": "The short description under the heading."
    },
    "sections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "hint"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "$ref": "#/$defs/bilingual"
          },
          "hint": {
            "$ref": "#/$defs/bilingual"
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 4,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "bilingual": {
      "type": "object",
      "required": [
        "en",
        "bn"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "$ref": "#/$defs/text"
        },
        "bn": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "id",
        "order",
        "section",
        "title",
        "badge",
        "recap",
        "questions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "$ref": "#/$defs/slug",
          "description": "The id of one of the course's sections."
        },
        "title": {
          "$ref": "#/$defs/bilingual"
        },
        "badge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "The formula or micro-rule shown in the card's badge, e.g. “was / were + V3”."
        },
        "recap": {
          "type": "object",
          "required": [
            "rule",
            "example"
          ],
          "additionalProperties": false,
          "properties": {
            "rule": {
              "$ref": "#/$defs/bilingual",
              "description": "The rule in one or two short sentences."
            },
            "example": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "prompt",
        "options",
        "answer",
        "explanation"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "prompt": {
          "$ref": "#/$defs/text",
          "description": "___ marks the gap to fill."
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "a",
                  "b",
                  "c",
                  "d"
                ]
              },
              "text": {
                "$ref": "#/$defs/text"
              },
              "why": {
                "$ref": "#/$defs/text",
                "description": "Why this choice is wrong. Every option except the answer has one."
              }
            }
          }
        },
        "answer": {
          "enum": [
            "a",
            "b",
            "c",
            "d"
          ],
          "description": "The id of the correct option."
        },
        "explanation": {
          "$ref": "#/$defs/text",
          "description": "Why the correct answer is right."
        }
      }
    }
  }
}
