{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bulbuli.org/schemas/grammar-quiz-topic.json",
  "title": "Bulbuli grammar quiz topic",
  "description": "One grammar topic (here: English tenses) split into modules. Each module has a short recap and multiple-choice questions. Learner-facing words that Bangla speakers need are given in both languages; the English example sentences stay English.",
  "type": "object",
  "required": ["version", "topic", "modules"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "topic": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "$ref": "#/$defs/bilingual" }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 },
    "bilingual": {
      "type": "object",
      "required": ["en", "bn"],
      "additionalProperties": false,
      "properties": {
        "en": { "$ref": "#/$defs/text" },
        "bn": { "$ref": "#/$defs/text" }
      }
    },
    "module": {
      "type": "object",
      "required": ["id", "order", "time", "aspect", "title", "recap", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug", "description": "Also the address: /grammar/<id>" },
        "order": { "type": "integer", "minimum": 1 },
        "time": { "enum": ["present", "past", "future"] },
        "aspect": { "enum": ["simple", "continuous", "perfect", "perfect-continuous"] },
        "title": { "$ref": "#/$defs/bilingual" },
        "recap": {
          "type": "object",
          "description": "The rule summary shown before the questions.",
          "required": ["use", "form", "signals", "examples", "tip"],
          "additionalProperties": false,
          "properties": {
            "use": { "$ref": "#/$defs/bilingual", "description": "When to use the tense." },
            "form": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["pattern", "example"],
                "additionalProperties": false,
                "properties": {
                  "pattern": { "$ref": "#/$defs/text", "description": "e.g. am / is / are + verb-ing" },
                  "example": { "$ref": "#/$defs/text" }
                }
              }
            },
            "signals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" }, "description": "Signal words that point to this tense." },
            "examples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
            "tip": { "$ref": "#/$defs/text", "description": "One common mistake to avoid." }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "prompt", "options", "answer", "explanation"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "prompt": { "$ref": "#/$defs/text", "description": "___ marks the gap to fill." },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "additionalProperties": false,
            "properties": {
              "id": { "enum": ["a", "b", "c", "d"] },
              "text": { "$ref": "#/$defs/text" },
              "why": { "$ref": "#/$defs/text", "description": "Why this choice is wrong. Every option except the answer has one." }
            }
          }
        },
        "answer": { "enum": ["a", "b", "c", "d"], "description": "The id of the correct option." },
        "explanation": { "$ref": "#/$defs/text", "description": "Why the correct answer is right." }
      }
    }
  }
}
