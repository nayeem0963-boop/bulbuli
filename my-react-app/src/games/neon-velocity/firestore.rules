rules_version = '2';

// Bulbuli: Neon Velocity — Firestore security rules
// Deploy: firebase deploy --only firestore:rules
//
// boards/{boardId}/entries/{uid}  one best run per player per board
// ghosts/{boardId}_{uid}          that run's replay
//
// These rules stop vandalism and obviously impossible scores. They can't prove
// a run was played honestly — for real anti-cheat, re-simulate the submitted
// ghost in a Cloud Function and only then write the entry.

service cloud.firestore {
  match /databases/{database}/documents {

    function plausible(d) {
      return d.keys().hasAll(['name', 'score', 'distance', 'timeMs', 'crystals', 'maxSpeedKmh', 'surges'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 16
        && d.score is int && d.distance is int && d.timeMs is int && d.crystals is int
        && d.score >= 0 && d.distance >= 0 && d.crystals >= 0
        && d.timeMs >= 1000
        // max run speed ≈ 18 m/s × 2.2 × 1.6 (surge) ≈ 64 m/s → allow 70
        && d.distance <= d.timeMs / 1000 * 70
        // score = distance + crystal points (≤ 100 per crystal incl. surge doubling)
        && d.score <= d.distance + d.crystals * 100
        && d.maxSpeedKmh <= 260;
    }

    match /boards/{boardId}/entries/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && plausible(request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && plausible(request.resource.data)
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }

    match /ghosts/{ghostId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && ghostId == request.resource.data.boardId + '_' + request.auth.uid
        && request.resource.data.ghost.data is string
        && request.resource.data.ghost.data.size() < 400000;
    }
  }
}
